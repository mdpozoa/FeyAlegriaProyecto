# ──────────────────────────────────────────────────────────
# SafeCampus Monitor — Variables de Entorno
# Copiar como .env.local y llenar con valores reales
# NUNCA subir este archivo al repositorio con datos reales
# ──────────────────────────────────────────────────────────

# ── BACKEND (Vercel Serverless Functions) ─────────────────

# Conexión a Supabase PostgreSQL (Transaction Mode - pgbouncer)
DATABASE_URL="postgresql://postgres.PROJECT_ID:PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Secret — clave larga y aleatoria (mínimo 64 caracteres)
# Generar en: https://randomkeygen.com (Fort Knox Passwords)
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_MUY_LARGA_Y_ALEATORIA

# Credenciales del Administrador (se crean en /api/setup)
ADMIN_EMAIL=admin@safecampus.edu.ec
ADMIN_PASSWORD=TuContraseñaSegura123!
ADMIN_NAME=Administrador SafeCampus

# Clave para proteger el endpoint de setup
SETUP_KEY=safecampus-setup-2024

# ── FRONTEND (Vite — prefijo VITE_) ──────────────────────

# URL base de la API — dejar vacío en Vercel (usa /api relativo)
# En local con vercel dev: también vacío
# Solo si usas un backend separado: poner la URL completa
VITE_API_BASE_URL=

# Configuración del Mapa Leaflet
VITE_MAP_DEFAULT_LAT=-0.2100
VITE_MAP_DEFAULT_LNG=-78.4980
VITE_MAP_DEFAULT_ZOOM=16
