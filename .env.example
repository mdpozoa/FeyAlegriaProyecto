# Variables de entorno para SafeCampus Monitor
# Copiar este archivo como .env y llenar con valores reales

# ──────────────────────────────────────────
# BACKEND (server/)
# ──────────────────────────────────────────

# Puerto del servidor (Railway lo pone automáticamente)
PORT=3000

# URL del frontend (para CORS). En Railway/Vercel, poner la URL real
FRONTEND_URL=http://localhost:5173

# Clave secreta para firmar JWT — ¡CAMBIAR SIEMPRE EN PRODUCCIÓN!
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_MUY_LARGA_Y_ALEATORIA

# Credenciales del administrador (se crean automáticamente al iniciar)
ADMIN_EMAIL=admin@safecampus.edu.ec
ADMIN_PASSWORD=SafeCampus2024!
ADMIN_NAME=Administrador SafeCampus

# ──────────────────────────────────────────
# FRONTEND (src/) — Variables VITE_
# ──────────────────────────────────────────

# URL base del backend (en producción: URL de Railway)
VITE_API_BASE_URL=http://localhost:3000/api

# Configuración del Mapa
VITE_MAP_DEFAULT_LAT=-0.2100
VITE_MAP_DEFAULT_LNG=-78.4980
VITE_MAP_DEFAULT_ZOOM=16
