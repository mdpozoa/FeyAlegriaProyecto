# Archivo de ejemplo para variables de entorno
# Copiar este archivo como .env y llenar con valores reales para local

# Base URL de la API (Si existiera un backend real)
VITE_API_BASE_URL=https://api.ejemplo.com/v1

# Configuración del Mapa
VITE_MAP_DEFAULT_LAT=-0.2100
VITE_MAP_DEFAULT_LNG=-78.4980
VITE_MAP_DEFAULT_ZOOM=16

# Claves de terceros (Ej: Mapbox si no usaras OSM)
VITE_MAPBOX_TOKEN=tu_token_aqui
